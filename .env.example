PORT=3000
SESSION_SECRET=change-me

# Postgres connection, used for user accounts, passkeys and collections.
DATABASE_URL=postgres://opintotodiste:opintotodiste@localhost:5432/opintotodiste

# WebAuthn/passkey relying-party config, used by the passkey login used to
# manage collections. RP_ID must be a bare domain (no scheme/port) matching
# what the browser sees; ORIGIN must be the exact origin. localhost + http://
# works for local dev only (browsers treat localhost as a secure context);
# production needs the real HTTPS domain/origin or ceremonies fail outright.
RP_ID=localhost
RP_NAME=Opintotodiste
ORIGIN=http://localhost:3000

# Identity used as the "issuer" in issued Open Badges credentials.
ISSUER_ID=did:web:example.org
ISSUER_NAME=Example Issuer

# A https://github.com/digitalcredentials/signing-service instance, used by
# the direct "Get credential" (sign & download) button.
SIGNING_SERVICE_URL=http://localhost:4006
SIGNING_SERVICE_INSTANCE_ID=test
SIGNING_SERVICE_SUITE=ed25519

# A https://github.com/FindyFi/oid4vci-issuer instance, used by the
# "Add to wallet" button. Note that service needs its own SIGNING_SERVICE_URL
# configured too (pointing at the same signing-service) - it signs directly,
# not through this app, once a wallet completes the flow.
OID4VCI_ISSUER_URL=http://localhost:4007
OID4VCI_ISSUER_INSTANCE=test
OID4VCI_ISSUER_TOKEN=change-me
