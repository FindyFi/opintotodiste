PORT=3000
SESSION_SECRET=change-me

# Postgres connection, used for user accounts, passkeys and collections.
DATABASE_URL=postgres://opintotodiste:opintotodiste@localhost:5432/opintotodiste

# WebAuthn/passkey relying-party config, used by the passkey login used to
# manage collections. RP_ID must be a bare domain (no scheme/port) matching
# what the browser sees; ORIGIN must be the exact origin. localhost + http://
# works for local dev only (browsers treat localhost as a secure context);
# production needs the real HTTPS domain/origin or ceremonies fail outright.
RP_ID=localhost
RP_NAME=Opintotodiste
ORIGIN=http://localhost:3000

# Identity used as the "issuer" in issued Open Badges credentials.
ISSUER_ID=did:web:example.org
ISSUER_NAME=Example Issuer

# A https://github.com/digitalcredentials/signing-service instance, used by
# the direct "Get credential" (sign & download) button.
SIGNING_SERVICE_URL=http://localhost:4006
SIGNING_SERVICE_INSTANCE_ID=test
SIGNING_SERVICE_SUITE=ed25519

# A https://github.com/FindyFi/oid4vci-issuer instance, used by the
# "Add to wallet" button. It signs the wallet credential itself (vc+sd-jwt,
# with its own key), not through this app or signing-service. It only needs
# its own SIGNING_SERVICE_URL for the ldp_vc configuration, which this app
# does not use for wallets.
OID4VCI_ISSUER_URL=http://localhost:4007
OID4VCI_ISSUER_INSTANCE=test
OID4VCI_ISSUER_TOKEN=change-me

# The credential configuration the app asks oid4vci-issuer for when it
# creates a wallet offer. Wallet credentials are dc+sd-jwt (IETF SD-JWT VC);
# downloads stay ldp_vc (signed via signing-service above).
OID4VCI_CREDENTIAL_CONFIGURATION_ID=OpenBadgeCredentialSdJwtVc

# The vct of that dc+sd-jwt configuration. When set, wallet offers carry flat
# SD-JWT VC claims; leave it unset to send a VCDM 2.0 VC instead (for the
# vc+sd-jwt configuration OpenBadgeCredentialSdJwt, which uses
# OID4VCI_CREDENTIAL_ISSUER_ID below).
OID4VCI_CREDENTIAL_VCT=http://localhost:4007/vct/OpenBadgeCredential

# The issuer id written into wallet credentials (issuer.id). It must be
# exactly the oid4vci-issuer's SD-JWT issuer URL (its CREDENTIAL_ISSUER, or
# SD_JWT_ISSUER if that is set), with no path. Offers with any other issuer
# are rejected with a 400.
OID4VCI_CREDENTIAL_ISSUER_ID=http://localhost:4007
